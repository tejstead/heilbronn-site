import Heil7.Hull6OneNegativeData

/-!
# Exact certificate for the one-negative H6 scalar inequality

This is the kernel-checked semantic bridge for the 924-entry fallback
certificate generated by `support/h6_one_negative_bernstein.py`.

The cleared numerator is kept in its short factored form.  Fourteen `ring`
identities check the generated rational tables: the three Bernstein layers in
the interval parameter use triangular subdivision orders 3, 2, and 1.  The
remaining theorems route an arbitrary point of `p,t >= 0, p+t <= 3` to the
appropriate cell and combine the three positive layers.
-/

set_option linter.style.header false

namespace HeilbronnChallenge.N7Upper

/-- The exact polynomial `-(w*d)^2*G0`, constructed without division.

Here `s = h + z*(smax-h)`, with `R=1/w`, `h=2/d`, and
`smax=3-p-t-R`.  The factored construction is the authoritative counterpart
of `build_numerator` in the generator. -/
def h6OneNegativeNumerator (p t z : ℝ) : ℝ :=
  let w := 4 - p - t
  let d := 3 + 4 * p - p ^ 2
  let wd := w * d
  let B := p + t + p * t - 1
  let spanNum := (w - 1) * wd - d - 2 * w
  let sNum := 2 * w + z * spanNum
  let lNum := (w ^ 2 - 1) * d - sNum
  let dNum := B * ((1 + t) * wd + sNum) + t * wd
  let cNum := (2 + p) * w + (1 + p)
  (1 + t) * cNum * w * d ^ 2 - lNum * dNum

/-- The three degree-two Bernstein layers in `z`. -/
def h6OneNegativeLayer0 (p t : ℝ) : ℝ :=
  h6OneNegativeNumerator p t 0

noncomputable def h6OneNegativeLayer1 (p t : ℝ) : ℝ :=
  2 * h6OneNegativeNumerator p t (1 / 2) -
    (h6OneNegativeNumerator p t 0 + h6OneNegativeNumerator p t 1) / 2

def h6OneNegativeLayer2 (p t : ℝ) : ℝ :=
  h6OneNegativeNumerator p t 1

theorem h6OneNegativeNumerator_layers (p t z : ℝ) :
    h6OneNegativeNumerator p t z =
      h6OneNegativeLayer0 p t * (1 - z) ^ 2 +
      2 * h6OneNegativeLayer1 p t * z * (1 - z) +
      h6OneNegativeLayer2 p t * z ^ 2 := by
  simp only [h6OneNegativeLayer0, h6OneNegativeLayer1,
    h6OneNegativeLayer2, h6OneNegativeNumerator]
  ring

private lemma certified_cell_pos
    (cell : Fin 14) (u v : ℝ)
    (hu : 0 ≤ u) (hv : 0 ≤ v) (huv : u + v ≤ 1) :
    0 < tri10Bernstein
      (fun k => (h6OneNegativeBernsteinData cell k : ℝ)) u v := by
  exact tri10Bernstein_rat_pos
    (h6OneNegativeBernsteinData cell)
    (h6OneNegativeBernsteinMin cell) u v
    (h6OneNegativeBernsteinMin_pos cell)
    (h6OneNegativeBernsteinData_lower cell) hu hv huv

/-! ## Layer zero: the order-three triangular grid -/

set_option maxHeartbeats 2000000 in
