theorem h6OneNegativeLayer1_pos
    {p t : ℝ} (hp : 0 ≤ p) (ht : 0 ≤ t) (hsum : p + t ≤ 3) :
    0 < h6OneNegativeLayer1 p t := by
  by_cases hp3 : p ≤ 3 / 2
  · by_cases ht3 : t ≤ 3 / 2
    · by_cases hs3 : p + t ≤ 3 / 2
      · let u := 2 * p / 3
        let v := 2 * t / 3
        have hu : 0 ≤ u := by simp only [u]; positivity
        have hv : 0 ≤ v := by simp only [v]; positivity
        have huv : u + v ≤ 1 := by simp only [u, v]; linarith
        convert layer1_U00_pos u v hu hv huv using 1 <;>
          simp only [u, v] <;> ring
      · let u := 2 * (p + t) / 3 - 1
        let v := 1 - 2 * p / 3
        have hu : 0 ≤ u := by simp only [u]; linarith
        have hv : 0 ≤ v := by simp only [v]; linarith
        have huv : u + v ≤ 1 := by simp only [u, v]; linarith
        convert layer1_D00_pos u v hu hv huv using 1 <;>
          simp only [u, v] <;> ring
    · let u := 2 * p / 3
      let v := 2 * t / 3 - 1
      have hu : 0 ≤ u := by simp only [u]; positivity
      have hv : 0 ≤ v := by simp only [v]; linarith
      have huv : u + v ≤ 1 := by simp only [u, v]; linarith
      convert layer1_U01_pos u v hu hv huv using 1 <;>
        simp only [u, v] <;> ring
  · let u := 2 * p / 3 - 1
    let v := 2 * t / 3
    have hu : 0 ≤ u := by simp only [u]; linarith
    have hv : 0 ≤ v := by simp only [v]; positivity
    have huv : u + v ≤ 1 := by simp only [u, v]; linarith
    convert layer1_U10_pos u v hu hv huv using 1 <;>
      simp only [u, v] <;> ring

/-! ## Layer two and the quadratic blend -/

set_option maxHeartbeats 2000000 in
private lemma layer2_U00_repr (u v : ℝ) :
    h6OneNegativeLayer2 (3 * u) (3 * v) =
      tri10Bernstein
        (fun k => (h6OneNegativeBernsteinData 13 k : ℝ)) u v := by
  norm_num [h6OneNegativeLayer2, h6OneNegativeNumerator,
    tri10Bernstein, h6OneNegativeBernsteinData,
    h6OneNegativeBernsteinRows]
  simp only [Matrix.cons_val]
  ring

theorem h6OneNegativeLayer2_pos
    {p t : ℝ} (hp : 0 ≤ p) (ht : 0 ≤ t) (hsum : p + t ≤ 3) :
    0 < h6OneNegativeLayer2 p t := by
  let u := p / 3
  let v := t / 3
  have hu : 0 ≤ u := by simp only [u]; positivity
  have hv : 0 ≤ v := by simp only [v]; positivity
  have huv : u + v ≤ 1 := by simp only [u, v]; linarith
  have hpos := certified_cell_pos 13 u v hu hv huv
  rw [← layer2_U00_repr] at hpos
  convert hpos using 1 <;> simp only [u, v] <;> ring

/-- Exact positivity of the cleared one-negative numerator on the whole
triangle times the closed interval. -/
theorem h6OneNegativeNumerator_pos
    {p t z : ℝ}
    (hp : 0 ≤ p) (ht : 0 ≤ t) (hsum : p + t ≤ 3)
    (hz0 : 0 ≤ z) (hz1 : z ≤ 1) :
    0 < h6OneNegativeNumerator p t z := by
  have h0 := h6OneNegativeLayer0_pos hp ht hsum
  have h1 := h6OneNegativeLayer1_pos hp ht hsum
  have h2 := h6OneNegativeLayer2_pos hp ht hsum
  have hcomp : 0 ≤ 1 - z := by linarith
  rw [h6OneNegativeNumerator_layers]
  by_cases hz : z = 0
  · simp only [hz, sub_zero, one_pow, mul_one, mul_zero, zero_mul,
      zero_pow (by decide : (2 : ℕ) ≠ 0), add_zero]
    exact h0
  · have hzpos : 0 < z := lt_of_le_of_ne hz0 (Ne.symm hz)
    have hfirst :
        0 ≤ h6OneNegativeLayer0 p t * (1 - z) ^ 2 := by positivity
    have hmiddle :
        0 ≤ 2 * h6OneNegativeLayer1 p t * z * (1 - z) := by positivity
    have hlast : 0 < h6OneNegativeLayer2 p t * z ^ 2 := by positivity
    linarith

end HeilbronnChallenge.N7Upper
