theorem h6OneNegativeLayer0_pos
    {p t : ℝ} (hp : 0 ≤ p) (ht : 0 ≤ t) (hsum : p + t ≤ 3) :
    0 < h6OneNegativeLayer0 p t := by
  by_cases hp1 : p ≤ 1
  · by_cases ht1 : t ≤ 1
    · by_cases hs1 : p + t ≤ 1
      · exact layer0_U00_pos p t hp ht hs1
      · let u := p + t - 1
        let v := 1 - p
        have hu : 0 ≤ u := by simp only [u]; linarith
        have hv : 0 ≤ v := by simp only [v]; linarith
        have huv : u + v ≤ 1 := by simp only [u, v]; linarith
        convert layer0_D00_pos u v hu hv huv using 1 <;>
          simp only [u, v] <;> ring
    · by_cases ht2 : t ≤ 2
      · by_cases hs2 : p + t ≤ 2
        · let u := p
          let v := t - 1
          have hu : 0 ≤ u := hp
          have hv : 0 ≤ v := by simp only [v]; linarith
          have huv : u + v ≤ 1 := by simp only [u, v]; linarith
          convert layer0_U01_pos u v hu hv huv using 1 <;>
            simp only [u, v] <;> ring
        · let u := p + t - 2
          let v := 1 - p
          have hu : 0 ≤ u := by simp only [u]; linarith
          have hv : 0 ≤ v := by simp only [v]; linarith
          have huv : u + v ≤ 1 := by simp only [u, v]; linarith
          convert layer0_D01_pos u v hu hv huv using 1 <;>
            simp only [u, v] <;> ring
      · let u := p
        let v := t - 2
        have hu : 0 ≤ u := hp
        have hv : 0 ≤ v := by simp only [v]; linarith
        have huv : u + v ≤ 1 := by simp only [u, v]; linarith
        convert layer0_U02_pos u v hu hv huv using 1 <;>
          simp only [u, v] <;> ring
  · by_cases hp2 : p ≤ 2
    · by_cases ht1 : t ≤ 1
      · by_cases hs2 : p + t ≤ 2
        · let u := p - 1
          let v := t
          have hu : 0 ≤ u := by simp only [u]; linarith
          have hv : 0 ≤ v := ht
          have huv : u + v ≤ 1 := by simp only [u, v]; linarith
          convert layer0_U10_pos u v hu hv huv using 1 <;>
            simp only [u, v] <;> ring
        · let u := p + t - 2
          let v := 2 - p
          have hu : 0 ≤ u := by simp only [u]; linarith
          have hv : 0 ≤ v := by simp only [v]; linarith
          have huv : u + v ≤ 1 := by simp only [u, v]; linarith
          convert layer0_D10_pos u v hu hv huv using 1 <;>
            simp only [u, v] <;> ring
      · let u := p - 1
        let v := t - 1
        have hu : 0 ≤ u := by simp only [u]; linarith
        have hv : 0 ≤ v := by simp only [v]; linarith
        have huv : u + v ≤ 1 := by simp only [u, v]; linarith
        convert layer0_U11_pos u v hu hv huv using 1 <;>
          simp only [u, v] <;> ring
    · let u := p - 2
      let v := t
      have hu : 0 ≤ u := by simp only [u]; linarith
      have hv : 0 ≤ v := ht
      have huv : u + v ≤ 1 := by simp only [u, v]; linarith
      convert layer0_U20_pos u v hu hv huv using 1 <;>
        simp only [u, v] <;> ring

