noncomputable def h6OneNegativeBernsteinMin (cell : Fin 14) : ℚ :=
  1 + ((h6OneNegativeBernsteinRows cell).minOffset : ℚ)

noncomputable def h6OneNegativeBernsteinData (cell : Fin 14) (k : Fin 66) : ℚ :=
  (1 + ((h6OneNegativeBernsteinRows cell).minOffset : ℚ)) +
    ((h6OneNegativeBernsteinRows cell).residual k : ℚ)

theorem h6OneNegativeBernsteinMin_pos :
    ∀ cell, 0 < h6OneNegativeBernsteinMin cell := by
  intro cell
  unfold h6OneNegativeBernsteinMin
  exact add_pos_of_pos_of_nonneg zero_lt_one
    (NNRat.coe_nonneg ((h6OneNegativeBernsteinRows cell).minOffset))

theorem h6OneNegativeBernsteinData_lower :
    ∀ cell k, h6OneNegativeBernsteinMin cell ≤
      h6OneNegativeBernsteinData cell k := by
  intro cell k
  unfold h6OneNegativeBernsteinMin h6OneNegativeBernsteinData
  exact le_add_of_nonneg_right
    (NNRat.coe_nonneg ((h6OneNegativeBernsteinRows cell).residual k))

